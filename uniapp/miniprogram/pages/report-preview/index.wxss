page {
  background: #0f141a;
}

.preview-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
}

.close-btn {
  position: fixed;
  right: 24rpx;
  top: 24rpx;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 52rpx;
  z-index: 10;
}

.image-wrap {
  width: 100%;
  height: calc(100vh - 56rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.doc-wrap {
  margin-top: 120rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 34rpx 30rpx;
}

.doc-status {
  margin-top: 20rpx;
  color: #47664a;
  font-size: 24rpx;
}

.doc-status.error {
  color: #b14545;
}

.web-topbar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  height: 120rpx;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
  background: rgba(15, 20, 26, 0.88);
  z-index: 999;
}

.web-close {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
  color: #ffffff;
  font-size: 52rpx;
  background: rgba(255, 255, 255, 0.16);
}

.web-title {
  margin-top: -66rpx;
  text-align: center;
  color: #ffffff;
  font-size: 28rpx;
  padding: 0 120rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
