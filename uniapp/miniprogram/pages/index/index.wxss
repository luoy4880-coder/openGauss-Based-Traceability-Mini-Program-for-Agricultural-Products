page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(210, 176, 109, 0.16), transparent 28%),
    linear-gradient(180deg, #f8f4ec 0%, #f3ecdf 100%);
  color: #2d2419;
}

.page {
  padding: 36rpx 28rpx 48rpx;
}

.hero {
  padding: 28rpx 8rpx 36rpx;
}

.hero-badge {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(114, 83, 37, 0.1);
  color: #725325;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 18rpx;
  color: #6f6251;
  font-size: 28rpx;
  line-height: 1.7;
}

.panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 252, 247, 0.92);
  box-shadow: 0 18rpx 40rpx rgba(114, 83, 37, 0.08);
}

.query-panel {
  margin-top: 8rpx;
}

.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
}

.panel-subtitle {
  color: #91816e;
  font-size: 22rpx;
}

.trace-input {
  margin-top: 22rpx;
  height: 92rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e0d4c1;
  border-radius: 20rpx;
  background: #fffdf9;
  font-size: 28rpx;
  box-sizing: border-box;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.primary-btn,
.ghost-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  border: none;
}

.primary-btn {
  background: linear-gradient(135deg, #58703a 0%, #7d9858 100%);
  color: #ffffff;
}

.ghost-btn {
  background: #efe6d8;
  color: #5f513f;
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}

.tip {
  margin-top: 20rpx;
  color: #8d7c67;
  font-size: 22rpx;
  line-height: 1.7;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #efe4d6;
}

.history-item:last-child {
  border-bottom: none;
  padding-bottom: 6rpx;
}

.history-name {
  font-size: 28rpx;
  font-weight: 600;
}

.history-code {
  margin-top: 8rpx;
  color: #8b7a66;
  font-size: 22rpx;
}

.history-arrow {
  flex-shrink: 0;
  color: #725325;
  font-size: 24rpx;
}
