page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(210, 176, 109, 0.16), transparent 28%),
    linear-gradient(180deg, #f8f4ec 0%, #f3ecdf 100%);
  color: var(--yj-text-main);
}

.page {
  padding: 36rpx 28rpx 48rpx;
}

/* Hero */
.hero {
  padding: 20rpx 4rpx 28rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--yj-text-main);
}

.hero-desc {
  margin-top: 18rpx;
  color: var(--yj-text-secondary);
  font-size: 28rpx;
  line-height: 1.7;
}

/* 查询面板 */
.query-panel {
  margin-top: 8rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--yj-text-main);
  margin-bottom: 20rpx;
}

.trace-input {
  width: 100%;
  box-sizing: border-box;
  margin-top: 4rpx;
  height: 92rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--yj-border);
  border-radius: var(--yj-radius-md);
  background: var(--yj-input-bg);
  font-size: 28rpx;
  color: #3d3227;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.primary-btn {
  flex: 1;
}

.ghost-btn {
  flex: 1;
}

.tip {
  margin-top: 20rpx;
  color: var(--yj-text-tertiary);
  font-size: 22rpx;
  line-height: 1.7;
}

/* 历史记录 */
.panel {
  margin-top: 24rpx;
}

.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.panel-subtitle {
  color: var(--yj-text-tertiary);
  font-size: 22rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--yj-border-light);
}

.history-item:last-child {
  border-bottom: none;
  padding-bottom: 6rpx;
}

.history-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--yj-text-main);
}

.history-code {
  margin-top: 8rpx;
  color: var(--yj-text-tertiary);
  font-size: 22rpx;
}

.history-arrow {
  flex-shrink: 0;
  color: var(--yj-accent);
  font-size: 24rpx;
  font-weight: 500;
}
