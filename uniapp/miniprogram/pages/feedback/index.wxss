page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(201, 146, 76, 0.12), transparent 24%),
    linear-gradient(180deg, #f8f4ec 0%, #f1e8db 100%);
  color: #2d2419;
}

.page {
  padding: 28rpx;
}

.feedback-header {
  padding: 10rpx 8rpx 18rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7b6d5d;
}

.login-tip {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 252, 247, 0.94);
  box-shadow: 0 10rpx 24rpx rgba(104, 76, 36, 0.08);
}

.tip-title {
  font-size: 28rpx;
  font-weight: 700;
}

.tip-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7b6d5d;
  line-height: 1.7;
}

.login-btn {
  margin-top: 18rpx;
  height: 78rpx;
  line-height: 78rpx;
  border: none;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #58703a 0%, #7d9858 100%);
  color: #ffffff;
  font-size: 26rpx;
}

.login-btn::after {
  border: none;
}

.feedback-form {
  margin-top: 18rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: rgba(255, 252, 247, 0.94);
  box-shadow: 0 10rpx 24rpx rgba(104, 76, 36, 0.08);
}

.form-item {
  margin-top: 18rpx;
}

.form-item:first-child {
  margin-top: 0;
}

.label {
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  border: 2rpx solid #e5d7c4;
  background: #fffdf9;
  font-size: 26rpx;
}

.arrow {
  color: #8b7a66;
}

.content-input {
  width: 100%;
  min-height: 240rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  border: 2rpx solid #e5d7c4;
  background: #fffdf9;
  font-size: 26rpx;
  line-height: 1.7;
}

.word-count {
  margin-top: 10rpx;
  text-align: right;
  font-size: 22rpx;
  color: #8b7a66;
}

.contact-input {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  border: 2rpx solid #e5d7c4;
  background: #fffdf9;
  font-size: 26rpx;
}

.submit-btn {
  margin-top: 22rpx;
  height: 84rpx;
  line-height: 84rpx;
  border: none;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #8b5f1d 0%, #c18a42 100%);
  color: #fff;
  font-size: 28rpx;
}

.submit-btn.disabled {
  opacity: 0.55;
}

.submit-btn::after {
  border: none;
}

.my-feedback {
  margin-top: 18rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: rgba(255, 252, 247, 0.94);
  box-shadow: 0 10rpx 24rpx rgba(104, 76, 36, 0.08);
}

.my-title {
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.my-loading,
.my-empty {
  color: #7b6d5d;
  font-size: 24rpx;
}

.my-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #efe5d6;
}

.my-item:last-child {
  border-bottom: none;
}

.my-type {
  font-size: 26rpx;
  font-weight: 700;
}

.my-content {
  margin-top: 8rpx;
  color: #635848;
  font-size: 24rpx;
  line-height: 1.7;
}

.my-time {
  margin-top: 8rpx;
  color: #8b7a66;
  font-size: 22rpx;
}
