%% 基于 OpenGauss 的农产品溯源系统流程图（单图多子流程版）
flowchart TD

  %% ================= 总体流程 =================
  subgraph G0[总体业务流程]
    subgraph WEB[Web 管理端]
      W1[登录 /api/auth/login] --> W2[基地管理]
      W2 --> W3[批次管理]
      W3 --> W4[生产记录]
      W3 --> W5[质检报告]
      W3 --> W6[生成溯源码]
      W3 --> W7[发起/关闭召回]
      W1 --> W8[仪表盘统计]
      W1 --> W9[个人资料弹窗修改]
    end

    subgraph MINI[小程序端]
      M1[输入或扫码 traceId] --> M2[查询 /api/trace/{traceId}]
      M2 --> M3[展示基地/批次/生产/质检/召回]
      M3 --> M4[保存查询历史]
      M3 --> M5[报告预览页]
      M3 --> M6[提交反馈]
      M7[登录/注册/绑定] --> M6
    end

    subgraph API[后端 Spring Boot]
      A1[鉴权拦截器 AuthInterceptor]
      A2[权限服务 AuthPermissionService]
      A3[业务控制器层]
      A4[服务层 Service]
      A5[数据访问层 Mapper]
    end

    subgraph DB[openGauss]
      D1[(sys_user/sys_role/sys_user_role)]
      D2[(base_info)]
      D3[(product_batch)]
      D4[(production_record)]
      D5[(inspection_report)]
      D6[(trace_code)]
      D7[(recall_record)]
      D8[(user_feedback)]
    end

    WEB --> A1
    MINI --> A1
    A1 --> A2 --> A3 --> A4 --> A5
    A5 --> DB
  end

  %% ================= 子流程1：认证与权限 =================
  subgraph G1[子流程1：认证与权限判定]
    U1[客户端请求 /api/**] --> U2{是否白名单接口?}
    U2 -- 是 --> U8[放行]
    U2 -- 否 --> U3[校验 Bearer Token]
    U3 --> U4{Token 是否有效?}
    U4 -- 否 --> U9[返回 401]
    U4 -- 是 --> U5[加载当前用户与角色]
    U5 --> U6{是否具备目标角色?}
    U6 -- 否 --> U10[返回 403]
    U6 -- 是 --> U7[进入业务处理]
  end

  %% ================= 子流程2：批次与溯源码 =================
  subgraph G2[子流程2：管理端批次与溯源码]
    B1[创建/维护基地] --> B2[创建批次]
    B2 --> B3[录入生产记录]
    B2 --> B4[录入质检报告]
    B2 --> B5[生成溯源码 /api/trace-codes/generate]
    B5 --> B6[生成 traceId + signValue(SHA-256)]
    B6 --> B7[保存 trace_code]
    B7 --> B8[前端展示二维码/traceId]
    B2 --> B9[发起召回 /api/recalls]
    B9 --> B10[批次召回状态更新]
  end

  %% ================= 子流程3：小程序查询 =================
  subgraph G3[子流程3：小程序溯源查询与历史]
    Q1[首页输入/扫码 traceId] --> Q2[GET /api/trace/{traceId}]
    Q2 --> Q3{traceId 是否存在?}
    Q3 -- 否 --> Q9[提示查询失败]
    Q3 -- 是 --> Q4[后端聚合返回详情]
    Q4 --> Q5[展示基地/批次/生产/质检/召回]
    Q5 --> Q6[写入本地查询历史]
    Q6 --> Q7[历史页展示近7天查询量]
    Q5 --> Q8[进入报告预览页]
  end

  %% ================= 子流程4：反馈 =================
  subgraph G4[子流程4：反馈提交]
    F1[填写反馈表单] --> F2{是否登录?}
    F2 -- 否 --> F7[提示登录后提交]
    F2 -- 是 --> F3[POST /api/feedback]
    F3 --> F4[写入 user_feedback]
    F4 --> F5[返回提交成功]
    F5 --> F6[GET /api/feedback/my 查看我的反馈]
  end

  %% ================= 子流程5：个人信息修改 =================
  subgraph G5[子流程5：个人信息修改（管理端）]
    P1[点击 修改信息] --> P2[弹出编辑对话框]
    P2 --> P3[填写 realName/phone]
    P3 --> P4[PUT /api/auth/profile]
    P4 --> P5[后端按当前 token 用户更新]
    P5 --> P6[返回最新用户信息]
    P6 --> P7[前端刷新 /api/auth/me]
    P7 --> P8[页面显示更新后的资料]
  end
