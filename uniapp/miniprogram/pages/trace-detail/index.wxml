<view class="page">
  <view wx:if="{{loading}}" class="state-card yj-state-card"><view class="state-title">Loading trace details</view><view class="state-desc">Please wait while data is being fetched.</view></view>
  <view wx:elif="{{errorMessage}}" class="state-card yj-state-card error"><view class="state-title">Load failed</view><view class="state-desc">{{errorMessage}}</view><button class="retry-btn yj-btn-danger" bindtap="retryLoad">Retry</button></view>
  <block wx:elif="{{detail}}">
    <view class="banner yj-banner {{detail.recallWarning ? 'danger yj-banner-danger' : 'safe yj-banner-safe'}}"><view class="banner-label">{{detail.recallWarning ? 'Recall warning' : 'Normal status'}}</view><view class="banner-title">{{detail.batchInfo.productName || 'Product'}}</view><view class="banner-desc">Batch: {{detail.batchInfo.batchCode || 'N/A'}} | Trace: {{detail.traceCode.traceId}}</view></view>
    <view wx:if="{{summary}}" class="card yj-card ai-summary-card"><view class="card-title">AI Summary</view><view class="summary-head"><view class="summary-title">{{summary.summaryTitle}}</view><view class="summary-score">Trust {{summary.trustScore}}</view></view><view class="summary-text">{{summary.summaryText}}</view><view class="summary-tags"><view wx:for="{{summary.highlights}}" wx:key="*this" class="summary-tag">{{item}}</view></view><view class="summary-actions"><button class="mini-action-btn" bindtap="openQualityInterpretation">Quality View</button><button class="mini-action-btn" bindtap="openLogisticsTimeline">Logistics</button><button class="mini-action-btn plain" bindtap="saveCurrentFavorite">Collect</button></view></view>
    <view wx:if="{{detail.verifyInfo}}" class="card yj-card verify-card {{detail.verifyInfo && detail.verifyInfo.abnormal ? 'verify-danger' : 'verify-safe'}}"><view class="card-title">Verification</view><view class="verify-title">{{detail.verifyInfo.verifyMessage}}</view><view class="field yj-field"><text class="label">Scan count</text><text class="value">#{{detail.verifyInfo.scanCount}}</text></view><view class="field yj-field"><text class="label">First scan</text><text class="value">{{detail.verifyInfo.firstScan ? 'Yes' : 'No'}}</text></view><view wx:if="{{detail.verifyInfo.riskMessage}}" class="verify-risk">{{detail.verifyInfo.riskMessage}}</view></view>
    <view class="card yj-card chart-card"><view class="chart-head"><view class="card-title">Trace overview</view><view class="integrity-pill">Integrity {{integrityRate}}%</view></view><view class="chart-wrap"><view class="chart-item" wx:for="{{detailChart}}" wx:key="label"><view class="chart-value">{{item.value}}</view><view class="chart-bar-track"><view class="chart-bar-fill" style="height: {{item.percent}}%;"></view></view><view class="chart-label">{{item.label}}</view></view></view></view>
    <view class="card yj-card"><view class="card-title">Base info</view><view class="field yj-field"><text class="label">Base name</text><text class="value">{{detail.baseInfo.baseName || 'N/A'}}</text></view><view class="field yj-field"><text class="label">Manager</text><text class="value">{{detail.baseInfo.managerName || 'N/A'}}</text></view><view class="field yj-field"><text class="label">Phone</text><text class="value">{{detail.baseInfo.contactPhone || 'N/A'}}</text></view><view class="field yj-field"><text class="label">Address</text><text class="value">{{detail.baseInfo.fullAddress}}</text></view></view>
    <view class="card yj-card"><view class="card-title">Batch info</view><view class="field yj-field"><text class="label">Product</text><text class="value">{{detail.batchInfo.productName || 'N/A'}}</text></view><view class="field yj-field"><text class="label">Category</text><text class="value">{{detail.batchInfo.productCategory || 'N/A'}}</text></view><view class="field yj-field"><text class="label">Planting</text><text class="value">{{detail.batchInfo.plantingDateText}}</text></view><view class="field yj-field"><text class="label">Expected harvest</text><text class="value">{{detail.batchInfo.expectedHarvestDateText}}</text></view><view class="field yj-field"><text class="label">Actual harvest</text><text class="value">{{detail.batchInfo.actualHarvestDateText}}</text></view><view class="field yj-field"><text class="label">Quantity</text><text class="value">{{detail.batchInfo.quantity || 'N/A'}} {{detail.batchInfo.unit || ''}}</text></view></view>
    <view class="card yj-card"><view class="card-title">Inspection reports</view><view wx:if="{{detail.inspectionReports.length === 0}}" class="empty-text">No inspection reports</view><view wx:for="{{detail.inspectionReports}}" wx:key="id" class="report-item"><view class="report-row"><text class="report-name">{{item.reportName}}</text><text class="report-badge">{{item.resultStatusLabel}}</text></view><view class="report-text">Agency: {{item.agencyName || 'N/A'}}</view><view class="report-text">Time: {{item.inspectionTimeText}}</view><view class="report-text">Conclusion: {{item.conclusion || 'N/A'}}</view><view class="report-actions"><text wx:if="{{item.reportUrl}}" class="report-preview-link" data-url="{{item.reportUrl}}" data-name="{{item.reportName}}" bindtap="previewReportFile">Preview report</text></view></view></view>
    <view class="card yj-card"><view class="card-title">Logistics</view><view wx:if="{{!detail.logisticsRecords || detail.logisticsRecords.length === 0}}" class="empty-text">No logistics records</view><view wx:for="{{detail.logisticsRecords.slice(0, 2)}}" wx:key="id" class="timeline-item yj-timeline-item logistics-item"><view class="timeline-time">{{item.operationTimeText}}</view><view class="timeline-title">{{item.nodeType}} / {{item.nodeName}}</view><view class="timeline-desc">Location: {{item.location || 'N/A'}} | Operator: {{item.operatorName || 'N/A'}}</view><view class="timeline-desc">Temp/Humidity: {{item.temperature || '-'}} / {{item.humidity || '-'}}</view></view><view wx:if="{{detail.logisticsRecords.length > 2}}" class="report-actions"><text class="report-preview-link" bindtap="openLogisticsTimeline">查看完整物流时间线</text></view></view>
  </block>
</view>
