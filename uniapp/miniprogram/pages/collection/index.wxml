<view class="page"><view wx:if="{{list.length === 0}}" class="state-card yj-state-card"><view class="state-title">暂无收藏</view><view class="state-desc">在溯源详情页点击 Collect 可保存常用商品。</view></view><view wx:for="{{list}}" wx:key="traceId" class="card yj-card"><view class="report-row"><text class="report-name">{{item.productName}}</text><text>{{item.batchCode}}</text></view><view class="report-text">Trace ID: {{item.traceId}}</view><view class="report-actions"><text class="report-preview-link" data-trace-id="{{item.traceId}}" bindtap="openDetail">查看详情</text><text class="report-preview-link" data-trace-id="{{item.traceId}}" bindtap="removeItem">移除</text></view></view></view>
