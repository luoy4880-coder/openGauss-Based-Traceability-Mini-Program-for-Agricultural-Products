<view class="page">
  <view class="hero yj-card" wx:if="{{list.length}}">
    <view class="hero-label">收藏夹</view>
    <view class="hero-title">已保存 {{list.length}} 个常用溯源码</view>
    <view class="hero-desc">常查商品可以先收藏，下次直接从这里进入详情。</view>
  </view>

  <view wx:if="{{list.length === 0}}" class="state-card yj-state-card">
    <view class="state-title">暂无收藏</view>
    <view class="state-desc">在溯源详情页点击“加入收藏”即可保存常用商品。</view>
    <button class="primary-btn yj-btn-primary" bindtap="backToTrace">去查溯源</button>
  </view>

  <view wx:for="{{list}}" wx:key="traceId" class="favorite-card yj-card">
    <view class="card-top">
      <view class="title-wrap">
        <view class="product-name">{{item.productName}}</view>
        <view class="saved-chip">{{item.savedAtText}}</view>
      </view>
    </view>

    <view class="meta-grid">
      <view class="meta-item">
        <view class="meta-label">批次编号</view>
        <view class="meta-value">{{item.batchCode || '暂无'}}</view>
      </view>
      <view class="meta-item">
        <view class="meta-label">溯源码</view>
        <view class="meta-code">{{item.traceId}}</view>
      </view>
    </view>

    <view class="card-actions">
      <button
        class="action-btn ghost-btn yj-btn-ghost"
        data-trace-id="{{item.traceId}}"
        data-sign-value="{{item.signValue}}"
        bindtap="openDetail"
      >
        查看详情
      </button>
      <button
        class="action-btn action-btn-danger"
        data-trace-id="{{item.traceId}}"
        data-sign-value="{{item.signValue}}"
        bindtap="removeItem"
      >
        移除收藏
      </button>
    </view>
  </view>
</view>
