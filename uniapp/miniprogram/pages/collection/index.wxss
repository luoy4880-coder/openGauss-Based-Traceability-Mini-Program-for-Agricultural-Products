.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top right, rgba(125, 152, 88, 0.12), transparent 30%),
    linear-gradient(180deg, #f8f4ec 0%, #f3ecdf 100%);
}

.hero {
  margin-bottom: 22rpx;
  background: linear-gradient(135deg, rgba(88, 112, 58, 0.96) 0%, rgba(125, 152, 88, 0.92) 100%);
  color: #fffdf8;
  box-shadow: 0 18rpx 40rpx rgba(88, 112, 58, 0.22);
}

.hero-label {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: var(--yj-radius-pill);
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: rgba(255, 253, 248, 0.82);
}

.state-card .primary-btn {
  margin-top: 28rpx;
}

.favorite-card {
  margin-bottom: 20rpx;
}

.title-wrap {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.product-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  color: var(--yj-text-main);
}

.saved-chip {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: var(--yj-radius-pill);
  background: #efe4d4;
  color: #74511f;
  font-size: 22rpx;
  line-height: 1.2;
}

.meta-grid {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--yj-border-light);
}

.meta-item + .meta-item {
  margin-top: 18rpx;
}

.meta-label {
  font-size: 22rpx;
  color: var(--yj-text-tertiary);
  letter-spacing: 1rpx;
}

.meta-value {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--yj-text-secondary);
  line-height: 1.6;
}

.meta-code {
  margin-top: 10rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--yj-radius-lg);
  background: #fbf7f0;
  border: 1rpx solid var(--yj-border-light);
  color: var(--yj-text-main);
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.card-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0;
  padding: 0;
  border-radius: var(--yj-radius-md);
  font-size: 26rpx;
  font-weight: 600;
}

.action-btn::after {
  border: none;
}

.action-btn-danger {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: var(--yj-radius-md);
  background: #f7e6df;
  color: var(--yj-danger);
  font-size: 26rpx;
  font-weight: 600;
}

.action-btn-danger::after {
  border: none;
}
