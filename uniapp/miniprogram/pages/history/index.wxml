<view class="page">
  <view class="header">
    <view class="title">查询记录</view>
    <button class="ghost-btn" wx:if="{{history.length}}" bindtap="clearHistory">清空</button>
  </view>

  <view class="card" wx:if="{{history.length === 0}}">
    <view class="empty-title">暂无记录</view>
    <view class="empty-desc">你查询过的追溯码会显示在这里。</view>
    <button class="primary-btn" bindtap="goToQuery">去查询</button>
  </view>

  <view
    class="item"
    wx:for="{{history}}"
    wx:key="traceId"
    data-trace-id="{{item.traceId}}"
    bindtap="openTraceDetail"
  >
    <view class="item-main">
      <view class="item-title">{{item.productName || '农产品'}}</view>
      <view class="item-sub">追溯码：{{item.traceId}}</view>
      <view class="item-time">查询时间：{{formatTimestamp(item.queryTime)}}</view>
    </view>
    <button class="link-btn" data-trace-id="{{item.traceId}}" catchtap="removeHistory">删除</button>
  </view>
</view>
