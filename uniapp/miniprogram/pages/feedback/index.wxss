page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(201, 146, 76, 0.12), transparent 24%),
    linear-gradient(180deg, #f8f4ec 0%, #f1e8db 100%);
  color: var(--yj-text-main);
}

.page {
  padding: 28rpx;
}

/* 头部 */
.feedback-header {
  padding: 10rpx 8rpx 18rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--yj-text-main);
}

.subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--yj-text-secondary);
}

/* 登录提示 */
.login-tip {
  margin-top: 18rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--yj-text-main);
}

.tip-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--yj-text-secondary);
  line-height: 1.7;
}

.login-btn {
  margin-top: 18rpx;
  width: 100%;
}

/* 表单 */
.feedback-form {
  margin-top: 18rpx;
}

.form-item {
  margin-top: 18rpx;
}

.form-item:first-child {
  margin-top: 0;
}

.label {
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  color: var(--yj-text-main);
  display: block;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: var(--yj-radius-md);
  border: 2rpx solid var(--yj-border);
  background: var(--yj-input-bg);
  font-size: 26rpx;
  color: var(--yj-text-main);
}

.arrow {
  color: var(--yj-text-tertiary);
  font-size: 20rpx;
}

.word-count {
  margin-top: 10rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--yj-text-tertiary);
}

.submit-btn {
  margin-top: 22rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--yj-radius-md);
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  background: linear-gradient(135deg, var(--yj-accent) 0%, var(--yj-accent-light) 100%);
  color: #fff;
  width: 100%;
  box-shadow: 0 8rpx 24rpx rgba(114, 83, 37, 0.22);
}

.submit-btn.disabled {
  opacity: 0.55;
  box-shadow: none;
}

.submit-btn::after {
  border: none;
}

/* 我的反馈 */
.my-feedback {
  margin-top: 18rpx;
}

.my-title {
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
  color: var(--yj-text-main);
}

.my-loading,
.my-empty {
  color: var(--yj-text-secondary);
  font-size: 24rpx;
}

.my-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--yj-border-light);
}

.my-item:last-child {
  border-bottom: none;
}

.my-type {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--yj-text-main);
}

.my-content {
  margin-top: 8rpx;
  color: #635848;
  font-size: 24rpx;
  line-height: 1.7;
}

.my-time {
  margin-top: 8rpx;
  color: var(--yj-text-tertiary);
  font-size: 22rpx;
}
