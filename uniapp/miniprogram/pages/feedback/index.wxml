<view class="page">
  <view class="feedback-header">
    <view class="title">意见反馈</view>
    <view class="subtitle">提交使用问题、商品投诉、物流异常或功能建议</view>
  </view>

  <view class="login-tip yj-card" wx:if="{{!loggedIn}}">
    <view class="tip-title">登录后才能提交反馈</view>
    <view class="tip-desc">请先到“我的”页面登录，再回来继续提交。</view>
    <button class="login-btn yj-btn-primary" bindtap="goToLogin">去登录</button>
  </view>

  <view class="feedback-form yj-card">
    <view class="form-item">
      <view class="label">反馈类型</view>
      <picker bindchange="onTypeChange" value="{{typeIndex}}" range="{{typeOptions}}">
        <view class="picker-box">
          <text>{{typeOptions[typeIndex]}}</text>
          <text class="arrow">▼</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="label">关联最近查询记录（可选）</view>
      <picker bindchange="onTraceChange" value="{{traceIndex}}" range="{{traceOptions}}" range-key="productName">
        <view class="picker-box">
          <text wx:if="{{traceIndex < 0}}">可直接提交，也可关联最近查过的商品</text>
          <text wx:else>{{traceOptions[traceIndex].productName}} / {{traceOptions[traceIndex].batchCode}}</text>
          <text class="arrow">▼</text>
        </view>
      </picker>
      <view class="word-count" wx:if="{{traceOptions.length === 0}}">当前还没有查询记录，也可以直接提交反馈。</view>
    </view>

    <view class="form-item">
      <view class="label">反馈内容</view>
      <textarea
        class="content-input yj-textarea"
        placeholder="请详细描述问题或建议，至少 5 个字"
        bindinput="onContentInput"
        value="{{content}}"
        maxlength="500"
      ></textarea>
      <view class="word-count">{{content.length}}/500</view>
    </view>

    <view class="form-item">
      <view class="label">联系方式（可选）</view>
      <input
        class="contact-input yj-input"
        placeholder="请输入手机号或邮箱，方便我们联系您"
        bindinput="onContactInput"
        value="{{contact}}"
      />
    </view>

    <button
      class="submit-btn {{!content || content.length < 5 ? 'disabled' : ''}}"
      bindtap="submitFeedback"
      loading="{{submitting}}"
      disabled="{{submitting || !content || content.length < 5}}"
    >
      提交反馈
    </button>
  </view>

  <view class="my-feedback yj-card" wx:if="{{loggedIn}}">
    <view class="my-title">我最近的反馈</view>
    <view class="my-loading" wx:if="{{loadingMyFeedback}}">加载中...</view>
    <view class="my-empty" wx:if="{{!loadingMyFeedback && myFeedback.length === 0}}">暂无反馈记录</view>
    <view wx:for="{{myFeedback}}" wx:key="id" class="my-item">
      <view class="my-type">{{item.type || '反馈'}}</view>
      <view class="my-content">{{item.content}}</view>
      <view class="my-time">{{item.createdAt ? item.createdAt.replace('T',' ').slice(0,19) : ''}}</view>
    </view>
  </view>
</view>
