page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f4ec 0%, #f3ecdf 100%);
  color: var(--yj-text-main);
}

.page {
  padding: 20rpx;
}

/* 用户卡片 */
.user-card {
  margin-bottom: 24rpx;
}

.avatar-text {
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.user-desc {
  font-size: 24rpx;
  opacity: 0.9;
}

.login-btn,
.logout-btn {
  font-size: 24rpx;
  color: var(--yj-primary);
  background: #ffffff;
  padding: 12rpx 22rpx;
  border-radius: var(--yj-radius-pill);
  line-height: 1;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.login-btn::after,
.logout-btn::after {
  border: none;
}

.logout-btn {
  color: #a74747;
}

/* 功能区 */
.main-section {
  margin-bottom: 24rpx;
}

.icon {
  font-size: 30rpx;
}

.feature-content {
  flex: 1;
  min-width: 0;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--yj-text-main);
  margin-bottom: 6rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: var(--yj-text-secondary);
}

.feature-arrow {
  font-size: 24rpx;
  color: var(--yj-text-tertiary);
  font-weight: bold;
  margin-left: 12rpx;
}
