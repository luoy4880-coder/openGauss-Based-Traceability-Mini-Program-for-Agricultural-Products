page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f4ec 0%, #f3ecdf 100%);
  color: var(--yj-text-main);
}

.page {
  padding: 20rpx;
}

/* 标签页 */
.tabs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: var(--yj-radius-md);
  background: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
  color: #6b5b4a;
  font-weight: 500;
  border: 1rpx solid transparent;
}

.tab.active {
  background: #ffffff;
  color: var(--yj-text-main);
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border-color: rgba(88, 112, 58, 0.12);
}

.tab text {
  line-height: 1;
}

/* 面板 */
.tip-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--yj-text-main);
}

.tip-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--yj-text-secondary);
  line-height: 1.7;
}

.field-title {
  margin-top: 14rpx;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--yj-text-main);
}

.field-title:first-child {
  margin-top: 0;
}

.primary-btn {
  margin-top: 22rpx;
}

.tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--yj-text-secondary);
  line-height: 1.7;
}
