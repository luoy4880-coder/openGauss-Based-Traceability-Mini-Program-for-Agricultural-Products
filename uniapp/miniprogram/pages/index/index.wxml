<view class="page">
  <view class="hero">
    <view class="hero-badge">YUJIA TRACE</view>
    <view class="hero-title">农产品溯源查询</view>
    <view class="hero-desc">输入追溯码或直接扫码，快速查看基地、生产、检测与召回信息。</view>
  </view>

  <view class="panel query-panel">
    <view class="panel-title">查询入口</view>
    <input
      class="trace-input"
      placeholder="请输入追溯码，例如 8f4c..."
      value="{{traceId}}"
      bindinput="onTraceInput"
      confirm-type="search"
      bindconfirm="submitTraceQuery"
    />
    <view class="action-row">
      <button class="primary-btn" loading="{{loading}}" bindtap="submitTraceQuery">立即查询</button>
      <button class="ghost-btn" bindtap="scanTraceCode">扫码识别</button>
    </view>
    <view class="tip">提示：开发者工具可直接输入追溯码；手机联调前请确认后端地址可访问。</view>
  </view>

  <view class="panel" wx:if="{{history.length}}">
    <view class="panel-head">
      <view class="panel-title">最近查询</view>
      <view class="panel-subtitle">最多保留 8 条本地记录</view>
    </view>
    <view
      class="history-item"
      wx:for="{{history}}"
      wx:key="traceId"
      data-trace-id="{{item.traceId}}"
      bindtap="useHistoryTrace"
    >
      <view class="history-main">
        <view class="history-name">{{item.productName}}</view>
        <view class="history-code">{{item.traceId}}</view>
      </view>
      <view class="history-arrow">查看</view>
    </view>
  </view>
</view>