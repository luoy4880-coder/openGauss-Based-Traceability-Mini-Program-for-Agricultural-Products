page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(123, 151, 90, 0.14), transparent 30%),
    linear-gradient(180deg, #f6f1e7 0%, #efe5d6 100%);
  color: var(--yj-text-main);
}

.page {
  padding: 26rpx;
}

.state-card {
  margin-top: 20vh;
}

.state-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--yj-text-main);
}

.state-desc {
  margin-top: 16rpx;
  color: var(--yj-text-secondary);
  font-size: 26rpx;
  line-height: 1.7;
}

.error {
  border: 2rpx solid rgba(181, 75, 75, 0.18);
}

.retry-btn {
  margin-top: 24rpx;
  width: 60%;
}

.banner-label {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: var(--yj-radius-pill);
  background: rgba(255, 255, 255, 0.14);
  font-size: 22rpx;
  font-weight: 500;
}

.banner-title {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.banner-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  opacity: 0.92;
}

.card {
  margin-top: 24rpx;
}

.card-title {
  margin-bottom: 20rpx;
  color: var(--yj-text-main);
  font-size: 32rpx;
  font-weight: 700;
}

.ai-summary-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.58);
}

.ai-summary-card::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -40rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  pointer-events: none;
}

.summary-safe {
  background: linear-gradient(135deg, rgba(233, 240, 222, 0.92) 0%, rgba(255, 252, 247, 0.98) 56%, rgba(242, 248, 235, 0.96) 100%);
}

.summary-check {
  background: linear-gradient(135deg, rgba(240, 234, 214, 0.94) 0%, rgba(255, 252, 247, 0.98) 58%, rgba(248, 242, 227, 0.96) 100%);
}

.summary-caution {
  background: linear-gradient(135deg, rgba(249, 235, 214, 0.94) 0%, rgba(255, 251, 245, 0.98) 58%, rgba(250, 241, 228, 0.96) 100%);
}

.summary-risk {
  background: linear-gradient(135deg, rgba(253, 232, 225, 0.96) 0%, rgba(255, 250, 247, 0.98) 58%, rgba(250, 238, 232, 0.96) 100%);
}

.summary-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.summary-top-main {
  flex: 1;
  min-width: 0;
}

.summary-eyebrow {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: var(--yj-radius-pill);
  background: rgba(255, 255, 255, 0.54);
  color: #6b5634;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.summary-title {
  margin-top: 18rpx;
  color: var(--yj-text-main);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}

.summary-desc {
  margin-top: 12rpx;
  color: var(--yj-text-secondary);
  font-size: 24rpx;
  line-height: 1.7;
}

.summary-status-chip {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: var(--yj-radius-pill);
  background: rgba(255, 255, 255, 0.68);
  color: var(--yj-text-main);
  font-size: 22rpx;
  font-weight: 700;
}

.summary-score-panel {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  padding: 22rpx 22rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.56);
  backdrop-filter: blur(10rpx);
}

.summary-score-copy {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.summary-score-label {
  color: var(--yj-text-secondary);
  font-size: 23rpx;
}

.summary-score-value {
  color: var(--yj-text-main);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.summary-score-track {
  margin-top: 16rpx;
  height: 14rpx;
  border-radius: var(--yj-radius-pill);
  background: rgba(117, 98, 62, 0.12);
  overflow: hidden;
}

.summary-score-fill {
  height: 100%;
  border-radius: var(--yj-radius-pill);
  background: linear-gradient(90deg, #c7b07a 0%, #86a05c 55%, #58703a 100%);
}

.summary-section {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
}

.summary-section-title {
  margin-bottom: 14rpx;
  color: var(--yj-text-main);
  font-size: 26rpx;
  font-weight: 700;
}

.summary-text {
  color: var(--yj-text-secondary);
  font-size: 25rpx;
  line-height: 1.8;
}

.summary-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.summary-tag {
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.68);
  color: #5b4930;
  font-size: 23rpx;
  line-height: 1.4;
  border: 1rpx solid rgba(201, 183, 153, 0.28);
}

.summary-dual {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
}

.summary-info-block + .summary-info-block {
  margin-top: 18rpx;
}

.summary-list-item {
  position: relative;
  margin-top: 10rpx;
  padding: 18rpx 18rpx 18rpx 50rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 1.7;
}

.summary-list-item::before {
  content: '';
  position: absolute;
  left: 20rpx;
  top: 28rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.summary-list-risk {
  background: rgba(178, 74, 51, 0.08);
  color: #8a4330;
}

.summary-list-risk::before {
  background: #b24a33;
  box-shadow: 0 0 0 6rpx rgba(178, 74, 51, 0.12);
}

.summary-list-action {
  background: rgba(88, 112, 58, 0.08);
  color: #48652f;
}

.summary-list-action::before {
  background: #58703a;
  box-shadow: 0 0 0 6rpx rgba(88, 112, 58, 0.12);
}

.summary-actions {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.mini-action-btn {
  min-width: 204rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  padding: 0 24rpx;
  border: none;
  border-radius: 18rpx;
  background: linear-gradient(135deg, var(--yj-primary) 0%, var(--yj-primary-light) 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(88, 112, 58, 0.14);
}

.mini-action-btn::after {
  border: none;
}

.mini-action-btn.plain {
  background: rgba(255, 255, 255, 0.72);
  color: #5d4d3b;
  box-shadow: none;
}

.chart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.integrity-pill {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: var(--yj-radius-pill);
  background: #edf3e4;
  color: #4f6f34;
  font-size: 22rpx;
}

.chart-value {
  margin-bottom: 10rpx;
  color: #6a5a45;
  font-size: 22rpx;
  font-weight: 500;
}

.chart-label {
  margin-top: 10rpx;
  color: var(--yj-text-tertiary);
  font-size: 22rpx;
}

.label {
  width: 160rpx;
  flex-shrink: 0;
  color: var(--yj-text-tertiary);
  font-size: 24rpx;
}

.value {
  flex: 1;
  color: var(--yj-text-main);
  font-size: 26rpx;
  line-height: 1.6;
  text-align: right;
}

.timeline-time {
  color: var(--yj-text-tertiary);
  font-size: 22rpx;
}

.timeline-title {
  margin-top: 6rpx;
  color: var(--yj-text-main);
  font-size: 28rpx;
  font-weight: 600;
}

.timeline-desc {
  margin-top: 6rpx;
  color: var(--yj-text-secondary);
  font-size: 24rpx;
  line-height: 1.7;
}

.report-name {
  color: var(--yj-text-main);
  font-size: 28rpx;
  font-weight: 600;
}

.report-badge {
  padding: 6rpx 16rpx;
  border-radius: var(--yj-radius-pill);
  background: #efe4d4;
  color: #74511f;
  font-size: 22rpx;
}

.report-text {
  margin-top: 8rpx;
  color: var(--yj-text-secondary);
  font-size: 24rpx;
  line-height: 1.7;
}

.report-actions {
  margin-top: 14rpx;
}

.report-preview-link {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: var(--yj-radius-pill);
  background: #e9f0de;
  color: #4f6f34;
  font-size: 23rpx;
  font-weight: 600;
}

.report-preview-disabled {
  color: var(--yj-text-tertiary);
  font-size: 22rpx;
}

.empty-text,
.safe-text {
  font-size: 24rpx;
  line-height: 1.7;
}

.empty-text {
  color: var(--yj-text-secondary);
}

.safe-text {
  color: var(--yj-safe);
  font-weight: 500;
}

.danger-text {
  color: #b24a33;
  font-weight: 600;
}

.recall-card {
  border: 2rpx solid rgba(187, 85, 52, 0.18);
}

.verify-card {
  border: 2rpx solid rgba(91, 132, 63, 0.18);
}

.verify-safe {
  background: linear-gradient(135deg, rgba(233, 240, 222, 0.9), #fffaf3);
}

.verify-danger {
  border-color: rgba(178, 74, 51, 0.25);
  background: linear-gradient(135deg, rgba(255, 229, 221, 0.95), #fffaf3);
}

.verify-title {
  margin-bottom: 12rpx;
  color: var(--yj-text-main);
  font-size: 30rpx;
  font-weight: 700;
}

.verify-risk {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(178, 74, 51, 0.1);
  color: #b24a33;
  font-size: 24rpx;
  line-height: 1.6;
}

.code-value {
  word-break: break-all;
  font-size: 22rpx;
}

.logistics-item {
  border-left-color: #6c8d4f;
}
