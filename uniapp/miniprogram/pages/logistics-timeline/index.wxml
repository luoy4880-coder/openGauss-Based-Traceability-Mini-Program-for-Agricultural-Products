<view class="page"><view wx:if="{{list.length === 0}}" class="state-card yj-state-card"><view class="state-title">暂无物流记录</view><view class="state-desc">当前没有可展示的流通节点。</view></view><view wx:for="{{list}}" wx:key="id" class="card yj-card"><view class="timeline-time">{{item.operationTimeText}}</view><view class="timeline-title">{{item.nodeType}} / {{item.nodeName}}</view><view class="timeline-desc">地点：{{item.location || '未填写'}}</view><view class="timeline-desc">操作人：{{item.operatorName || '未填写'}}</view><view class="timeline-desc">温湿度：{{item.temperature || '-'}} / {{item.humidity || '-'}}</view><view wx:if="{{item.remark}}" class="timeline-desc">备注：{{item.remark}}</view></view></view>
