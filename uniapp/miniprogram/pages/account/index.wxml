<view class="page">
  <view class="tabs">
    <view class="tab {{mode === 'login' ? 'active' : ''}}" data-mode="login" bindtap="switchMode"><text>登录</text></view>
    <view class="tab {{mode === 'register' ? 'active' : ''}}" data-mode="register" bindtap="switchMode"><text>注册</text></view>
    <view class="tab {{mode === 'bind' ? 'active' : ''}}" data-mode="bind" bindtap="switchMode"><text>绑定</text></view>
  </view>

  <view class="panel yj-card" wx:if="{{mode === 'bind' && !loggedIn}}">
    <view class="tip-title">需要先登录</view>
    <view class="tip-desc">请先使用微信登录或账号登录，再进行账号绑定。</view>
    <button class="primary-btn yj-btn-primary" bindtap="goToProfile">前往“我的”页登录</button>
  </view>

  <view class="panel yj-card">
    <view class="field-title">用户名</view>
    <input class="input yj-input" placeholder="请输入用户名" value="{{username}}" bindinput="onUsernameInput" />

    <view class="field-title">密码</view>
    <input class="input yj-input" password placeholder="请输入密码" value="{{password}}" bindinput="onPasswordInput" />

    <view wx:if="{{mode !== 'login'}}">
      <view class="field-title">姓名（可选）</view>
      <input class="input yj-input" placeholder="请输入姓名" value="{{realName}}" bindinput="onRealNameInput" />

      <view class="field-title">手机号（可选）</view>
      <input class="input yj-input" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <view class="tip" wx:if="{{mode === 'register'}}">公开注册默认创建消费者账号，无需绑定公司即可扫码查溯源。</view>

    <button class="primary-btn yj-btn-primary" loading="{{submitting}}" bindtap="submit">
      {{mode === 'login' ? '登录' : (mode === 'register' ? '注册并登录' : '绑定账号')}}
    </button>

    <view class="tip" wx:if="{{mode === 'bind'}}">
      绑定后可使用“账号密码登录”。
    </view>
  </view>
</view>
