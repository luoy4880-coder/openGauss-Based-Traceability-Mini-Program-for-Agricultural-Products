<view class="page">
  <view class="hero">
    <view class="hero-title">农产品溯源查询</view>
    <view class="hero-desc">输入追溯码或直接扫码，快速查看生产、质检与物流信息。</view>
  </view>

  <view class="query-panel yj-card">
    <view class="panel-title">查询入口</view>
    <input
      class="trace-input"
      placeholder="请输入追溯码，例如 8f4c..."
      value="{{traceId}}"
      bindinput="onTraceInput"
      confirm-type="search"
      bindconfirm="submitTraceQuery"
    />
    <view class="action-row">
      <button class="primary-btn yj-btn-primary" loading="{{loading}}" bindtap="submitTraceQuery">立即查询</button>
      <button class="ghost-btn yj-btn-ghost" bindtap="scanTraceCode">扫码识别</button>
    </view>
  </view>

  <view class="panel yj-card" wx:if="{{history.length}}">
    <view class="panel-head">
      <view class="panel-title">最近查询</view>
    </view>
    <view
      class="history-item"
      wx:for="{{history}}"
      wx:key="traceId"
      data-trace-id="{{item.traceId}}"
      data-sign-value="{{item.signValue}}"
      bindtap="useHistoryTrace"
    >
      <view class="history-main">
        <view class="history-name">{{item.productName}}</view>
        <view class="history-code">{{item.traceId}}</view>
      </view>
      <view class="history-arrow">查看详情</view>
    </view>
  </view>
</view>
